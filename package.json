{
  "name": "flood-watch",
  "private": true,
  "version": "0.1.0",
  "description": "PWA ติดตามสถานการณ์น้ำท่วม กทม. และปริมณฑล",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @flood-watch/api & npm run dev --workspace @flood-watch/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "deploy": "wrangler deploy",
    "cf:dev": "wrangler dev"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "wrangler": "^4.141.0"
  }
}
