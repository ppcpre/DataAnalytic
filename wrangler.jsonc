{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dataanalytic",
  "main": "apps/api/src/worker.ts",
  // build หน้าเว็บก่อน deploy ทุกครั้ง (ใช้ได้ทั้ง Cloudflare Workers Builds และ wrangler บนเครื่อง)
  "build": { "command": "npm run build --workspace @flood-watch/web" },
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "apps/web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "alias": {
    "@flood-watch/shared": "./packages/shared/src/index.ts"
  },
  // ดึงข้อมูลทุก 15 นาทีเพื่อเก็บประวัติระดับน้ำ (ลงฐานข้อมูล D1 ด้านล่าง)
  "triggers": { "crons": ["*/15 * * * *"] },
  // ฐานข้อมูลประวัติระดับน้ำ — ไม่ใส่ database_id: wrangler deploy สร้างฐานข้อมูลให้เองครั้งแรก
  // (automatic resource provisioning) แล้วผูกกับ Worker นี้ ตารางสร้างเองตอนใช้งาน (history.ts)
  "d1_databases": [{ "binding": "DB", "database_name": "flood-watch" }],
  "vars": {
    "DATA_MODE": "live",
    "KEY_STATION_CODES": "C.2,C.13,C.7A,C.35"
  }
  // ความลับ (เช่น GOOGLE_FLOOD_API_KEY) ตั้งด้วย: npx wrangler secret put GOOGLE_FLOOD_API_KEY
}
