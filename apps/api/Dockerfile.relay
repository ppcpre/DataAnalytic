# Relay สำหรับรันบนเครื่องในประเทศไทย (ดู docs/RELAY.md)
# build จากโฟลเดอร์รากของ repo: docker build -f apps/api/Dockerfile.relay -t flood-watch-relay .
FROM node:22-alpine AS build
WORKDIR /src
COPY apps/api/src/relay.ts apps/api/src/relay-server.ts ./src/
RUN npm init -y >/dev/null && npm install --no-audit --no-fund hono@4 @hono/node-server@2 esbuild@0.28 >/dev/null \
  && npx esbuild src/relay-server.ts --bundle --platform=node --format=esm --target=node20 --outfile=relay.js

FROM node:22-alpine
WORKDIR /app
COPY --from=build /src/relay.js ./relay.js
ENV PORT=8788
EXPOSE 8788
USER node
CMD ["node", "relay.js"]
